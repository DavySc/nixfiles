# Copy to local.kak (git-ignored) and keep only what this machine changes.
# Sourced before everything else, so these are defaults the modules build on.

# Languages this machine never needs: not loaded at all.
set-option global langs c verilog glsl markdown

# Keep the theme's own background (a terminal that is not transparent).
# set-option global transparent false

# Anything else, as in kakrc.
# set-option global windowing_placement vertical
